@page "/"
@* Sem prerender: com ele o OnInitializedAsync corria duas vezes e batia na API a dobrar. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Todo.Contracts
@using Todo.Web
@inject TodoApiClient Api
@implements IDisposable

<PageTitle>Todo</PageTitle>

<h1>Todo</h1>

<div class="compose">
    <input @bind="draft" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
           placeholder="What needs doing?" maxlength="200" aria-label="New task" />
    <button @onclick="AddAsync" disabled="@(!CanAdd || busy)">Add</button>
</div>

@if (failure is not null)
{
    <p class="failure" role="alert">@failure</p>
}

@if (items is null)
{
    <p class="muted">Loading...</p>
}
else if (items.Count == 0)
{
    <p class="muted">Nothing here yet.</p>
}
else
{
    <ul class="items">
        @foreach (var item in items)
        {
            <li @key="item.Id" class="@(item.IsDone ? "done" : null)">
                <label>
                    <input type="checkbox" checked="@item.IsDone" disabled="@busy"
                           @onchange="() => ToggleAsync(item.Id)" />
                    <span>@item.Title</span>
                </label>
                <button class="remove" disabled="@busy" aria-label="Remove"
                        @onclick="() => RemoveAsync(item.Id)">&times;</button>
            </li>
        }
    </ul>

    <p class="muted">@items.Count(item => !item.IsDone) of @items.Count remaining</p>
}

@code {
    private readonly CancellationTokenSource lifetime = new();

    private IReadOnlyList<TodoResponse>? items;
    private string draft = string.Empty;
    private string? failure;
    private bool busy;

    private bool CanAdd => !string.IsNullOrWhiteSpace(draft);

    protected override Task OnInitializedAsync() => RunAsync(RefreshAsync);

    private async Task RefreshAsync() => items = await Api.ListAsync(lifetime.Token);

    private Task AddAsync() => RunAsync(async () =>
    {
        if (await Api.AddAsync(draft, lifetime.Token) is null)
        {
            failure = "That title is not valid.";
            return;
        }

        draft = string.Empty;
        await RefreshAsync();
    });

    private Task ToggleAsync(Guid id) => RunAsync(async () =>
    {
        await Api.ToggleAsync(id, lifetime.Token);
        await RefreshAsync();
    });

    private Task RemoveAsync(Guid id) => RunAsync(async () =>
    {
        await Api.RemoveAsync(id, lifetime.Token);
        await RefreshAsync();
    });

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanAdd)
        {
            await AddAsync();
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        failure = null;

        try
        {
            await action();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            failure = "The API is unreachable. Is Todo.Api running?";
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
